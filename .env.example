# ==============================================================================
# Blood Donation Management Web App - Environment Configuration
# ==============================================================================

# 1. Google Sheets Persistent Database Configuration
# ID of the Google Spreadsheet named "Blood Donation Registration Database"
# (Found in the Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Service Account Email created in Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com

# Service Account Private Key (keep quotes and include private key headers)
# In Vercel or production .env, private keys with newlines can be formatted with literal \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 2. Authentication and Session Secret
# 32+ character random string for signing HTTP-only session tokens
AUTH_SECRET=generate_a_secure_random_32_character_secret_here

# 3. Authorized Administrator Credentials
# Administrator 1: Owner (Me)
OWNER_NAME="Owner"
OWNER_EMAIL="owner@blooddonation.org"
OWNER_PASSWORD="ReplaceWithOwnerSecurePassword2026!"

# Administrator 2: Second Administrator (My Friend)
SECOND_ADMIN_NAME="My Friend"
SECOND_ADMIN_EMAIL="friend@blooddonation.org"
SECOND_ADMIN_PASSWORD="ReplaceWithFriendSecurePassword2026!"
